  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SortOrStay.IntroSequence
  player: {fileID: 2003999384}
  puzzle: {fileID: 2074494082}
  playIntro: 1
  objective: "Sort the 6 keys from <b>smallest to largest</b>, the bubble sort way.\nCompare the <b>glowing pair</b>:  <b>swap</b> if the left key is bigger, otherwise they <b>stay</b>.\n<size=20>Pick up a glowing key, then click its neighbour (swap) or the same key (stay)  \xB7  hook numbers 1-6  \xB7  H hint</size>"
  lines:
  - ...ugh. Where am I?
  - One steel door. Six numbered keys on a rack.
  - 'The terminal glows:  ORDER UNLOCKS.'
