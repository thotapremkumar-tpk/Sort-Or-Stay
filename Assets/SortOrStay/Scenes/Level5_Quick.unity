  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SortOrStay.LevelIntro
  player: {fileID: 949221315}
  puzzle: {fileID: 272106194}
  overview: {fileID: 1890131683}
  holdTime: 2.2
  flyTime: 3
  objective: "<b>Quick sort</b> the gold bars, smallest first.\nRaise the <b>pivot</b> (the last bar).  Every other bar:  <b>smaller</b> goes behind the gate,  <b>bigger</b> stays.  Then drop the pivot into its place.\n<size=20>P pivot  \xB7  1 smaller  \xB7  2 bigger  \xB7  H hint</size>"
  lines:
  - 'Floor 5.  The vault:  the last door between you and the street.'
  - Eight gold bars, out of order.  The vault opens only for a sorted row.
  - Pick a pivot, split the rest around it, and do it again.
