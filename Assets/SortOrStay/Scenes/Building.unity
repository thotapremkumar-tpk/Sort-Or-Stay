  - number: 4
    title: "FLOOR 4  \xB7  THE CONTROL ROOM"
    roomName: The Control Room
    rooms:
    - number: 1
      sortCase: 1
      objective: "<b>Room 1  \xB7  best case:</b>  the blocks are <b>already in order</b>.\n<b>Merge sort</b> the data blocks, smallest first.\nPress <b>SPLIT</b> until every block stands alone.  Then merge two runs at a time:  always take the <b>smaller front block</b>.\n<size=20>Q split  \xB7  click a glowing front block, or press 1 (left) / 2 (right)  \xB7  H hint</size>"
      puzzle: {fileID: 1237208924}
      exitDoor: {fileID: 1417649735}
      entrance: {fileID: 497966874}
      root: {fileID: 999155667}
      roomMin: {x: 17.3, y: 5, z: -8.2}
