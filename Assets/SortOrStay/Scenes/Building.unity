--- !u!114 &1644569066
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1644569065}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0fff7bf7c8fc4f1a8bc4d734d577dfb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SortOrStay.BuildingManager
  floors:
  - number: 1
    title: "FLOOR 1  \xB7  THE LOCKED ROOM"
    roomName: The Locked Room
    rooms:
    - number: 1
      sortCase: 1
      objective: "<b>Room 1  \xB7  best case:</b>  the keys are <b>almost in order</b>.\nSort the 6 keys from <b>smallest to largest</b>, the bubble sort way.\nCompare the <b>glowing pair</b>:  <b>swap</b> if the left key is bigger, otherwise they <b>stay</b>.\n<size=20>Pick up a glowing key, then click its neighbour (swap) or the same key (stay)  \xB7  hook numbers 1-6  \xB7  H hint</size>"
      puzzle: {fileID: 50555190}
      exitDoor: {fileID: 899959133}
      entrance: {fileID: 458434300}
      root: {fileID: 2018035568}
      roomMin: {x: -4.4, y: 20, z: -5.2}
      roomMax: {x: 4.4, y: 23, z: 1.8}
      spawn: {x: 3.65, y: 20, z: -0.100000024}
      spawnYaw: 180
      entranceOutside: {x: 3.65, y: 20, z: 2.9}
      entranceInside: {x: 3.65, y: 20, z: -0.100000024}
      exitInside: {x: 0, y: 20, z: 0.6999999}
      exitOutside: {x: 0, y: 20, z: 3.5}
    - number: 2
      sortCase: 2
      objective: "<b>Room 2  \xB7  average case:</b>  the keys are in <b>random order</b>.\nSort the 6 keys from <b>smallest to largest</b>, the bubble sort way.\nCompare the <b>glowing pair</b>:  <b>swap</b> if the left key is bigger, otherwise they <b>stay</b>.\n<size=20>Pick up a glowing key, then click its neighbour (swap) or the same key (stay)  \xB7  hook numbers 1-6  \xB7  H hint</size>"
      puzzle: {fileID: 137574754}
      exitDoor: {fileID: 2038260849}
      entrance: {fileID: 46327173}
      root: {fileID: 2119808535}
      roomMin: {x: 4.7999997, y: 20, z: -5.2}
      roomMax: {x: 13.6, y: 23, z: 1.8}
      spawn: {x: 12.85, y: 20, z: -0.100000024}
      spawnYaw: 180
      entranceOutside: {x: 12.85, y: 20, z: 2.9}
      entranceInside: {x: 12.85, y: 20, z: -0.100000024}
      exitInside: {x: 9.2, y: 20, z: 0.6999999}
      exitOutside: {x: 9.2, y: 20, z: 3.5}
    - number: 3
      sortCase: 3
      objective: "<b>Room 3  \xB7  worst case:</b>  the keys are in <b>reverse order</b>:  every compare is a swap.\nSort the 6 keys from <b>smallest to largest</b>, the bubble sort way.\nCompare the <b>glowing pair</b>:  <b>swap</b> if the left key is bigger, otherwise they <b>stay</b>.\n<size=20>Pick up a glowing key, then click its neighbour (swap) or the same key (stay)  \xB7  hook numbers 1-6  \xB7  H hint</size>"
      puzzle: {fileID: 1773833948}
      exitDoor: {fileID: 1274705924}
      entrance: {fileID: 329392062}
      root: {fileID: 1400686962}
      roomMin: {x: 14, y: 20, z: -5.2}
      roomMax: {x: 22.8, y: 23, z: 1.8}
      spawn: {x: 22.05, y: 20, z: -0.100000024}
      spawnYaw: 180
      entranceOutside: {x: 22.05, y: 20, z: 2.9}
      entranceInside: {x: 22.05, y: 20, z: -0.100000024}
      exitInside: {x: 18.4, y: 20, z: 0.6999999}
      exitOutside: {x: 18.4, y: 20, z: 3.5}
    stairsGate: {fileID: 1164960242}
    entrance: {fileID: 0}
    root: {fileID: 1052188426}
    hallMin: {x: -4.6, y: 20, z: 2}
    hallMax: {x: 23, y: 23, z: 5}
    stairsPath:
    - {x: 21, y: 20, z: 3.5}
    - {x: 21, y: 20, z: 6}
    - {x: 21, y: 17.5, z: 11.22}
    - {x: 23.699999, y: 17.5, z: 11.22}
    - {x: 23.699999, y: 15, z: 6.2999997}
    - {x: 23.699999, y: 15, z: 4.3}
    - {x: 23.699999, y: 15, z: 3.5}
  - number: 2
    title: "FLOOR 2  \xB7  THE STORAGE ROOM"
    roomName: The Storage Room
    rooms:
    - number: 1
      sortCase: 1
      objective: "<b>Room 1  \xB7  best case:</b>  the crates are <b>already in order</b> (but you can't see the weights).\nSort the crates <b>light to heavy</b> into bays 1-7.\nEach pass: <b>weigh every crate that's left</b>, then send the <b>lightest</b> to the next bay.\n<size=20>Click a crate or press its bay number (1-7)  \xB7  Q weighs them all  \xB7  H hint</size>"
      puzzle: {fileID: 1849709605}
      exitDoor: {fileID: 717501895}
      entrance: {fileID: 836486731}
      root: {fileID: 431365351}
      roomMin: {x: 15.799999, y: 15, z: -8.2}
      roomMax: {x: 25.8, y: 19.4, z: 1.8}
      spawn: {x: 23.599998, y: 15, z: -0.100000024}
      spawnYaw: 180
      entranceOutside: {x: 23.599998, y: 15, z: 2.9}
      entranceInside: {x: 23.599998, y: 15, z: -0.100000024}
      exitInside: {x: 20.8, y: 15, z: 0.6999999}
      exitOutside: {x: 20.8, y: 15, z: 3.5}
    - number: 2
      sortCase: 2
      objective: "<b>Room 2  \xB7  average case:</b>  the weights are in <b>random order</b>.\nSort the crates <b>light to heavy</b> into bays 1-7.\nEach pass: <b>weigh every crate that's left</b>, then send the <b>lightest</b> to the next bay.\n<size=20>Click a crate or press its bay number (1-7)  \xB7  Q weighs them all  \xB7  H hint</size>"
      puzzle: {fileID: 2115184999}
      exitDoor: {fileID: 90539776}
      entrance: {fileID: 2145289425}
      root: {fileID: 1769609242}
      roomMin: {x: 5.3999996, y: 15, z: -8.2}
      roomMax: {x: 15.4, y: 19.4, z: 1.8}
      spawn: {x: 13.2, y: 15, z: -0.100000024}
      spawnYaw: 180
      entranceOutside: {x: 13.2, y: 15, z: 2.9}
      entranceInside: {x: 13.2, y: 15, z: -0.100000024}
      exitInside: {x: 10.4, y: 15, z: 0.6999999}
      exitOutside: {x: 10.4, y: 15, z: 3.5}
    - number: 3
      sortCase: 3
      objective: "<b>Room 3  \xB7  worst case:</b>  the <b>heaviest crate is first</b>:  a swap on every pass.\nSort the crates <b>light to heavy</b> into bays 1-7.\nEach pass: <b>weigh every crate that's left</b>, then send the <b>lightest</b> to the next bay.\n<size=20>Click a crate or press its bay number (1-7)  \xB7  Q weighs them all  \xB7  H hint</size>"
      puzzle: {fileID: 1598271961}
      exitDoor: {fileID: 290290954}
      entrance: {fileID: 2055054918}
      root: {fileID: 1498112228}
      roomMin: {x: -5, y: 15, z: -8.2}
      roomMax: {x: 5, y: 19.4, z: 1.8}
      spawn: {x: 2.8, y: 15, z: -0.100000024}
      spawnYaw: 180
      entranceOutside: {x: 2.8, y: 15, z: 2.9}
      entranceInside: {x: 2.8, y: 15, z: -0.100000024}
      exitInside: {x: 0, y: 15, z: 0.6999999}
      exitOutside: {x: 0, y: 15, z: 3.5}
    stairsGate: {fileID: 1067463480}
    entrance: {fileID: 1887864444}
    root: {fileID: 2058936337}
    hallMin: {x: -5.2, y: 15, z: 2}
    hallMax: {x: 26, y: 18, z: 5}
    stairsPath:
    - {x: 0.099999964, y: 15, z: 3.5}
    - {x: 0.099999964, y: 15, z: 6}
    - {x: 0.099999964, y: 12.5, z: 11.22}
    - {x: 2.8, y: 12.5, z: 11.22}
    - {x: 2.8, y: 10, z: 6.2999997}
    - {x: 2.8, y: 10, z: 4.3}
    - {x: 2.8, y: 10, z: 3.5}
  - number: 3
    title: "FLOOR 3  \xB7  THE LIBRARY"
    roomName: The Library
    rooms:
    - number: 1
      sortCase: 1
      objective: "<b>Room 1  \xB7  best case:</b>  the shelf is <b>nearly sorted</b>.\n<b>Insertion sort</b> the books on the shelf, smallest number first.\nPull out the glowing book;  <b>shift</b> a bigger left neighbour right (click it),  or <b>place</b> the book (click it).\n<size=20>Click the glowing book or press F  \xB7  click the glowing spot or press its number  \xB7  H hint</size>"
      puzzle: {fileID: 524360506}
      exitDoor: {fileID: 1387328439}
      entrance: {fileID: 1434651144}
      root: {fileID: 413123337}
      roomMin: {x: -5, y: 10, z: -7.2}
      roomMax: {x: 5, y: 13.8, z: 1.8}
      spawn: {x: 2.8, y: 10, z: -0.100000024}
      spawnYaw: 180
      entranceOutside: {x: 2.8, y: 10, z: 2.9}
      entranceInside: {x: 2.8, y: 10, z: -0.100000024}
      exitInside: {x: 0, y: 10, z: 0.6999999}
      exitOutside: {x: 0, y: 10, z: 3.5}
    - number: 2
      sortCase: 2
      objective: "<b>Room 2  \xB7  average case:</b>  the call numbers are in <b>random order</b>.\n<b>Insertion sort</b> the books on the shelf, smallest number first.\nPull out the glowing book;  <b>shift</b> a bigger left neighbour right (click it),  or <b>place</b> the book (click it).\n<size=20>Click the glowing book or press F  \xB7  click the glowing spot or press its number  \xB7  H hint</size>"
      puzzle: {fileID: 585896026}
