  - number: 3
    title: "FLOOR 3  \xB7  THE LIBRARY"
    roomName: The Library
    rooms:
    - number: 1
      sortCase: 1
      objective: "<b>Room 1  \xB7  best case:</b>  the shelf is <b>nearly sorted</b>.\n<b>Insertion sort</b> the books on the shelf, smallest number first.\nPull out the glowing book;  <b>shift</b> a bigger left neighbour right (click it),  or <b>place</b> the book (click it).\n<size=20>Click the glowing book or press F  \xB7  click the glowing spot or press its number  \xB7  H hint</size>"
      puzzle: {fileID: 1062276232}
      exitDoor: {fileID: 347995798}
      entrance: {fileID: 540785935}
      root: {fileID: 690758583}
      roomMin: {x: -5, y: 10, z: -7.2}
