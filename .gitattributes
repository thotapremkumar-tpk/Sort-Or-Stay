# Unity YAML and code: text, normalised line endings
* text=auto
*.cs        text diff=csharp
*.shader    text
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.mat       text eol=lf
*.anim      text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.meta      text eol=lf
*.inputactions text eol=lf

